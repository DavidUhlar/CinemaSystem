@page "/cinemahalls"
@using CinemaSystem.Models
@using Microsoft.EntityFrameworkCore
@inject CinemaSystem.Data.CinemaDbContext Db

<PageTitle>Cinema Halls</PageTitle>

<h1>Cinema Halls</h1>

@if (halls == null)
{
    <p><em>Loading...</em></p>
}
else if (!halls.Any())
{
    <p>No halls found.</p>
}
else
{
    @foreach (var hall in halls)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h5" Class="mb-3">@hall.Name</MudText>
            <MudText Typo="Typo.body2" Class="mb-4">
                Total Rows: @hall.TotalRows | Seats per Row: @hall.SeatsPerRow | Total Seats: @hall.Seats.Count
            </MudText>

            <MudTable Items="@GetHallRows(hall)" Dense="true" Hover="false" Elevation="0" Class="seat-table">
                <HeaderContent>
                    <MudTh>Row</MudTh>
                    @for (int seatNumber = 1; seatNumber <= hall.SeatsPerRow; seatNumber++)
                    {
                        var n = seatNumber;
                        <MudTh Class="text-center">@n</MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd><strong>@context.RowNumber</strong></MudTd>
                    @foreach (var seat in context.Seats)
                    {
                        <MudTd Class="text-center">
                            @if (seat != null)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           Size="Size.Small"
                                           Disabled="true">
                                    @seat.Number
                                </MudButton>
                            }
                            else
                            {
                                <MudText>-</MudText>
                            }
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
    @if (reservations != null)
    {
        @foreach (var res in reservations)
        {
            <div>
                <h3>Reservation ID: @res.Id</h3>
                <h3>Reservation ID: @res.ReservationCode</h3>
                <ul>
                    @foreach (var ticket in res.Tickets)
                    {
                        <li>Ticket ID: @ticket.Id - Seat ID: @ticket.SeatId</li>
                    }
                </ul>
            </div>
        }
    }
}

@code {
    private List<CinemaHall>? halls;
    private List<Reservation>? reservations;
    protected override async Task OnInitializedAsync()
    {
        halls = await Db.CinemaHalls
            .Include(h => h.Seats)
            .OrderBy(h => h.Id)
            .ToListAsync();

        reservations = await Db.Reservations
            .Include(h => h.Tickets)
            .OrderBy(h => h.Id)
            .ToListAsync();
    }

    private List<HallRow> GetHallRows(CinemaHall hall)
    {
        var rows = new List<HallRow>();

        for (int rowNumber = 1; rowNumber <= hall.TotalRows; rowNumber++)
        {
            var seatsInRow = new List<Seat?>();

            for (int seatNumber = 1; seatNumber <= hall.SeatsPerRow; seatNumber++)
            {
                var seat = hall.Seats.FirstOrDefault(s => s.Row == rowNumber && s.Number == seatNumber);
                seatsInRow.Add(seat);
            }

            rows.Add(new HallRow
            {
                RowNumber = rowNumber,
                Seats = seatsInRow
            });
        }

        return rows;
    }

    private class HallRow
    {
        public int RowNumber { get; set; }
        public List<Seat?> Seats { get; set; } = new();
    }
}